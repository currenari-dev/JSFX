desc: Acoustic Resonator (CURS)
// @author Currenari Sounds
// @version 2.9.4
// @changelog
//   - Initial release of Acoustic Resonator (CURS)
//   - 8-mode calibrated modal bank
//   - 17 acoustic materials and 16 presets
//   - 16-tap Velvet Cloud diffuser
//   - Mallet strike and bowed friction synthesis engine
//   - Real-time Chladni dial and live spectrum display
//   - True Peak limiter <= -3.0 dBFS
// @link Website https://currenari.com
// @description Acoustic Resonator & Synthesizer
// @about
//   # Acoustic Resonator (CURS)
//   Acoustic Resonator & Synthesizer by Currenari Sounds.
//   
//   Features 8-mode modal bank, 17 acoustic materials, 16 presets,
//   mallet strike and bowed friction synthesis engine, 16-tap Velvet Cloud diffuser,
//   sub foundation, True Peak -3.0 dBFS ceiling, and real-time Chladni visualizer.
// @provides
//   [effect] currenari_acoustic_resonator.jsfx

in_pin:Left Input (Source Audio)
in_pin:Right Input (Source Audio)
out_pin:Left Output
out_pin:Right Output

// --- SECTION 1: MASTER PRESET & TUNING ---
slider1:8<0,16,1{00: Manual / Custom,01: Terracotta Chamber (Warm Ceramic Resonance),02: Singing Bronze Bowl (Harmonic Tibetan Ring),03: Cathedral Vault (Spacious Acoustic Reverb),04: Resonant Spruce Timber (Acoustic Guitar/Harp Body),05: Quartz Glass Chime (Crystalline Ring),06: Foley Velvet Diffuser (Acoustic Texture Smear),07: Solid Oak Soundboard (Punchy Midrange Body),08: Nordic Bowed Tagelharpa (Bowed Horsehair Cello),09: Gothic Chamber Cello (Rich Low-End Sustain),10: Petrified Bog Ash (Dense Woody Drone),11: Hardwood Rim Percussion (Tight Transient Attack),12: Basalt Cavern Crypt (Dark Subterranean Space),13: Cast Gothic Bronze Bell (Tolling Overtone Chime),14: Forged Carnyx War Horn (Acoustic Brass Drive),15: 32ft Sub Organ Pipe (Deep Physical Sub Bass),16: Scandinavian Pine Lyre (Organic Plucked Cavity)}>Preset
slider2:50<0,100,1>Harmonic Spread
slider3:0<-24,24,1>Pitch Shift
slider4:82<10,100,1>Resonance Decay

// --- SECTION 2: DYNAMIC LEVELER & HARMONIC BODY ---
slider5:75<0,100,1>Exciter Level
slider6:60<0,100,1>Harmonic Warmth
slider7:4500<60,20000,10>Cutoff

// --- SECTION 3: VELVET CLOUD DIFFUSION & LIVING BREATH ---
slider8:65<0,100,1>Diffusion
slider9:55<10,100,1>Room Size
slider10:50<0,100,1>Living Breath
slider11:85<0,100,1>Stereo Width

// --- SECTION 4: MASTER MIX & OUTPUT ---
slider12:100<0,100,1>Mix
slider13:0<-60,12,0.1>Output Gain
slider14:0<0,1,1{Ready,RESET}>Reset

// --- SECTION 5: ACOUSTIC MATERIAL & EMDR BILATERAL ---
slider15:6<0,16,1{Terracotta Ceramic Pot (Eigenmodes),Hand-Hammered Singing Bronze (180 Hz),Quartz Crystal Glass Harmonica (220 Hz / A3),Hollow Resonant Spruce Body (110 Hz / A2),Celtic Drone Wood (Low B 61.7 Hz / B1),Aged Hollow Oak Timber (58.2 Hz / A#1),Nordic Pine Tagelharpa Body (55.0 Hz / A1),Hollow Eucalyptus Didgeridoo (73.4 Hz / D2),Gothic Chamber Cello (65.4 Hz / C2),Petrified Bog Ash Log (51.9 Hz / G#1),Resonant Cedar Frame Rim (69.3 Hz / C#2),Rosewood Marimba Bar (82.4 Hz / E2),Basalt Stone Cavern Chamber (48.0 Hz),Tolling Cast Cathedral Bell (110 Hz / A2),Forged Celtic Carnyx War Horn (87.3 Hz / F2),Subterranean 32ft Organ Pipe (32.7 Hz / C1),Scandinavian Pine Lyre Cavity (73.4 Hz / D2)}>Acoustic Material
slider16:35<0,100,1>Bilateral Depth
slider17:0.25<0.05,2.00,0.02>Bilateral Speed
slider18:40<0,100,1>Sub Foundation

// --- SECTION 6: MIDI & PHYSICAL EXCITATION ENGINE ---
slider19:0<0,3,1{Auto / Hybrid (Audio + MIDI),Audio Input Only,MIDI Mallet Strike,MIDI Bowed Friction}>Excitation Mode
slider20:75<0,100,1>Mallet Hardness

